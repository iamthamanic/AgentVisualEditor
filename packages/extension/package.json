{
  "name": "@agent-visual-editor/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension — Inspect Mode, pairing, WSS bridge (SLC-2)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node ./scripts/build-extension.mjs",
    "test": "tsc -p tsconfig.json && node --test test/**/*.test.ts"
  },
  "dependencies": {
    "@agent-visual-editor/protocol": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0"
  }
}
