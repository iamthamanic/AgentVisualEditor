{
  "name": "openclaw-plugin-agent-visual-editor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json",
    "test": "tsc -p tsconfig.json && node --test test/**/*.test.ts"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "dependencies": {
    "@agent-visual-editor/core": "*",
    "@agent-visual-editor/protocol": "*",
    "typebox": "^1.3.17"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "openclaw": "2026.9.5",
    "typescript": "^5.9.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.5"
    }
  }
}
