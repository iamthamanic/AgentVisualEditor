{
  "id": "agent-visual-editor",
  "name": "Agent Visual Editor",
  "description": "Native composer chips, pairing, extension bridge, send context, and agent tools for AgentVisualEditor.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "composerUiEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable composer chip region replacement."
      },
      "testSelectionEnabled": {
        "type": "boolean",
        "default": false,
        "description": "Show debug Test-Selektion button in the composer."
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "controlUi": {
    "entry": "dist/control-ui/35fa7cba5252f0f9d739fb2a6d1e71c9beb4e9964ddc5feddf91fb55819ea6b2/index.js",
    "styles": [
      "dist/control-ui/35fa7cba5252f0f9d739fb2a6d1e71c9beb4e9964ddc5feddf91fb55819ea6b2/index.css"
    ]
  },
  "contracts": {
    "tools": [
      "agent_visual_editor.get_active_context",
      "agent_visual_editor.get_screenshot",
      "agent_visual_editor.get_selection"
    ]
  },
  "toolMetadata": {
    "agent_visual_editor.get_screenshot": {
      "optional": true
    }
  }
}
